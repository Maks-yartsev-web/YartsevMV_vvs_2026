from functions4 import *

x = int(input('Введите первое число: '))
op = str(input('Введите знак операции: '))
y = int(input('Введите второе число: '))
print('Ответ:', end = ' ')
if op == '+':
    print(summa(x, y))
elif op == '-':
    print(raznost(x, y))
elif op == '*':
    print(proizvedenie(x, y))
elif op == '/':
    print(delenie(x, y))
else:
    print('Введены неверные значения!')
